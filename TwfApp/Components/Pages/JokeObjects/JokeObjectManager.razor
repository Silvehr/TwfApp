@inject JokeService JokeService;
@inject ModalService Modal;
@using TwfApp.Components.Partials
@using TwfApp.Types.JokeGenerator
@using TwfApp.Types.Modals
@page "/items"

<div class="component-container">
    <div class="page-header">
        <div class="input-group om-item om-searchbar">
            <InputText @bind-Value="_searchTerm" placeholder="Wyszukaj przedmiot..." class="form-control"/>
            <button class="btn" @onclick="LoadJokeObjects">
                <img src="glass.svg" class="icon" height="30"/>
            </button>
        </div>
        <div class="om-item">
            Znaleziono @_jokeObjects.Count przedmiotów
        </div>
        <div class="input-group om-item">
            <NavLink class="btn btn-primary" href="/items/new" style="width: 100%">
                Stwórz przedmiot &nbsp;&nbsp;<img src="boxes-inline.svg" style="height: 20px" />
            </NavLink>
        </div>
    </div>
    <div class="om-body">
        <div class="om-search-result">
            @foreach(var jokeObject in _jokeObjects)
            {
                <JokeObjectItem @key="jokeObject.Id" Model="jokeObject" />
            }
        </div>
        
    </div>
</div>

@code {
    private string _searchTerm = string.Empty;

    private List<JokeObject> _jokeObjects;

    protected override async Task OnInitializedAsync()
    {
        await LoadJokeObjects();
    }

    private async Task LoadJokeObjects()
    {
        var result = await JokeService.Database.GetJokeObjectsAsync(_searchTerm);
        if (!result.IsSuccess)
        {
            await Modal.ShowMessageAsync("Błąd ładowania przedmiotów", $"Aplikacja trafiła na nieoczekiwany błąd podczas ładowania przedmiotów: {result.Error!.Message}");
            _jokeObjects = [];
        }
        else
        {
            _jokeObjects = result.Value!.ToList();
        }
    }
}
