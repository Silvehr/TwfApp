@page "/";
@using System.Data.Common
@using Microsoft.Data.Sqlite
@using TwfApp.Types.Config
@using TwfApp.Types.Modals
@inject ServiceStartupResultCollectorService ResultCollector
@inject NavigationManager Navigation;
@inject JokeService JokeService;
@inject AppInitializer Initializer
@inject ModalService Modal;
<div class="home-root">
    <h2 style="width: 100%">
        Żart na @(DateOnly.FromDateTime(DateTime.Now).ToString("dd.MM.yyyy"))
    </h2>
    <div class="joke-container">
        @(rawJoke)
    </div>

    <button class="btn btn-primary" @onclick="JokeService.GenerateJoke">
        Wygeneruj żart
    </button>
</div>

@code{
    MarkupString rawJoke => (MarkupString)(JokeService.CurrentJoke is null ? "Błąd generowania żartu" : JokeService.CurrentJoke.Content);
    private static readonly FilePickerFileType JsonFileType = new FilePickerFileType(
        new Dictionary<DevicePlatform, IEnumerable<string>>
        {
            { DevicePlatform.WinUI, new[] { ".json" } },
            { DevicePlatform.MacCatalyst, new[] { "public.json" } },
            { DevicePlatform.Android, new[] { "application/json","text/json","text/plain" } },
            { DevicePlatform.iOS, new[] { "public.json" } }
        }
    );

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        
    }
}