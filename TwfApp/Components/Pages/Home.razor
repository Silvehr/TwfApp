@page "/";
@using System.Data.Common
@using Microsoft.Data.Sqlite
@using TwfApp.Types.Config
@using TwfApp.Types.Modals
@inject ServiceStartupResultCollectorService ResultCollector
@inject NavigationManager Navigation;
@inject JokeService JokeService;
@inject AppInitializer Initializer
@inject ModalService Modal;
<div class="home-root">
    <h2 style="width: 100%">
        Żart na @(DateOnly.FromDateTime(DateTime.Now).ToString("dd.MM.yyyy"))
    </h2>
    <div class="joke-container">
        @(RawJoke)
    </div>

    <button class="btn btn-primary" @onclick="JokeService.GenerateJoke">
        Wygeneruj żart
    </button>
</div>

@code{
    MarkupString RawJoke => (MarkupString)(JokeService.CurrentJoke is null ? "Błąd generowania żartu" : JokeService.CurrentJoke.Content);
    private static readonly FilePickerFileType JsonFileType = new(
        new Dictionary<DevicePlatform, IEnumerable<string>>
        {
            { DevicePlatform.WinUI, [".json"] },
            { DevicePlatform.MacCatalyst, ["public.json"] },
            { DevicePlatform.Android, ["application/json","text/json","text/plain"] },
            { DevicePlatform.iOS, ["public.json"] }
        }
    );

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var jokeServiceInitializationResult = ResultCollector.GetServiceInitializationResult<JokeService>();
        
        if (jokeServiceInitializationResult is not null)
        {
            await Modal.ShowMessageAsync("Błąd uruchomienia aplikacji", jokeServiceInitializationResult.Message);
        }  
    }
}