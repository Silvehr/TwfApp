@page "/items/{Mode}/{Id:int?}";
@using Microsoft.EntityFrameworkCore
@using TwfApp.Core
@using TwfApp.Infrastructure
@using TwfApp.Types.Modals
@inject KierownikappDbContext DbContext;
@inject ModalService Modal;
@inject NavigationManager Navigation;

<div class="page-container">
    <label id="item-title">
        <h2>
            @switch (Mode)
            {
                case "edit":
                    @($"Edytowanie ")
                    break;

                case "new":
                    @("Nowy przedmiot")
                    break;
            }
        </h2>
        <InputText @bind-Value="_model!.Name" disabled='@(Mode == "view")' placeholder="Nazwa przedmiotu" />
    </label>
    
    <label>
        <span class="field-name">Autor: </span>
        <InputText @bind-Value="_model.Author" disabled='@(Mode == "view")' />
    </label>
    <label>
        <span class="field-name">Opis</span>
        <InputTextArea @bind-Value="_model.Description" disabled='@(Mode == "view")' />
    </label>
    <label>
        <span class="field-name">Rodzaj</span>
        <InputSelect @bind-Value="_model.Type" disabled="@(Mode == "view")">
            <option value="@JokeObjectType.GenericObject">
                Obiekt podstawowy
            </option>
            <option value="@JokeObjectType.Food">
                Jedzenie
            </option>
        </InputSelect>
    </label>
    <label>
        <span class="field-name">Data powstania</span>
        <InputDate @bind-Value="_model.CreationDate" TValue="DateTime" disabled='@(Mode == "view")' />
    </label>

    <span class="actions">
        <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/items")'>
            Wróć
        </button>
        @if(Mode == "view")
        {
            @if(_model.Editable)
            {
                <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo($"/items/edit/${Id}")'>
                    Edytuj
                </button>
            }
        }
        else
        {
            @if(Mode == "edit")
            {
                <button class="btn btn-danger" @onclick="Delete">
                    Usuń
                </button>
            }

            <button class="btn btn-secondary" @onclick='Save'>
                Zapisz
            </button>
        }
    </span>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    [Parameter]
    public required string Mode { get; set; }

    private JokeObject? _model;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        switch(Mode)
        {
            case "view":
            case "edit":
                if (Id is null)
                {
                    Navigation.NotFound();
                    return;
                }

                _model = await DbContext.JokeObjects.FirstOrDefaultAsync(jo => jo.Id == Id);
                
                if(_model is null) Navigation.NotFound();
                
                break;

            case "new":
                _model = new JokeObject(0, "", "", "", JokeObjectType.GenericObject, DateTime.Today);
                Id = null;
                break;
        }
    }

    private void Delete()
    {
        DbContext.JokeObjects.Where(j => j.Id == _model.Id).ExecuteDelete();
        Navigation.NavigateTo("/items");
    }

    private async Task Save()
    { 
        if (Mode == "edit")
        {
            int count = await DbContext.JokeObjects.Where(jo => jo.Id == _model.Id).ExecuteUpdateAsync(jo =>
            {
                jo.SetProperty(j => j.Name, _model!.Name)
                    .SetProperty(j => j.Author, _model.Author)
                    .SetProperty(j => j.Description, _model.Description)
                    .SetProperty(j => j.Type, _model.Type)
                    .SetProperty(j => j.CreationDate, _model.CreationDate)
                    .SetProperty(j => j.Editable, _model.Editable);
            });

            if (count == 0)
                await Modal.ShowMessageAsync("Błąd edycji", "Nie znaleziono obiektu do edycji");
        }
        else
        {
            var existingObject = await DbContext.JokeObjects.FirstOrDefaultAsync(jo => jo.Name == _model!.Name);
            if (existingObject is not null)
            {
                await Modal.ShowMessageAsync("Błąd tworzenia przedmiotu", "Przedmito z taką nazwą już istnieje");
                return;
            }
            
            await DbContext.JokeObjects.AddAsync(_model);
            await DbContext.SaveChangesAsync();
        }
        Navigation.NavigateTo($"/items/view/{Id}"); 
    }
}
