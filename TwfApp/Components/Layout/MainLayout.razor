@using Microsoft.EntityFrameworkCore
@using TwfApp.Application.Services
@using TwfApp.Components.Partials
@using TwfApp.Infrastructure
@using TwfApp.Types.Config
@using TwfApp.Types.Modals
@inherits LayoutComponentBase
@inject KierownikappDbContext DbContext
@inject NavigationManager NavigationManager
@inject ModalService Modal
@inject IJokeService JokeService
@inject AppConfig Config

<ModalHost />

<div class="page">
    <span class="spacer"></span>

    <main>
        @Body
    </main>
    <Drawer>
        <DrawerEntryButton Name="Strona Główna" Icon="logo.png" OnClickCallback='() => NavigationManager.NavigateTo("/") ' />
        <DrawerEntryButton Name="Zarządzaj przedmiotami" Icon="boxes.svg" OnClickCallback='() => NavigationManager.NavigateTo("/items") ' />
        <DrawerEntryButton Name="Importuj przedmioty" Icon="download.svg" OnClickCallback="Import" />
        <DrawerEntryButton Name="Eksportuj przedmioty" Icon="upload.svg" OnClickCallback="Export" />
    </Drawer>
</div>

@code {
    private static readonly FilePickerFileType JsonFileType = new FilePickerFileType(
        new Dictionary<DevicePlatform, IEnumerable<string>>
        {
            { DevicePlatform.WinUI, [".json"] },
            { DevicePlatform.MacCatalyst, ["public.json"] },
            { DevicePlatform.Android, ["application/json","text/json","text/plain"] },
            { DevicePlatform.iOS, ["public.json"] }
        }
    );
    
    private async Task Import()
    {
        var file = await FilePicker.Default.PickAsync(options: new PickOptions { FileTypes = JsonFileType });

        if (file is null)
            return;

        await using var stream = await file.OpenReadAsync();
        
        JokeObjectExportData? jokeObjects;
        try
        {
            jokeObjects = await JsonSerializer.DeserializeAsync<JokeObjectExportData>(stream);
        }
        catch (JsonException)
        {
            await Modal.ShowMessageAsync("Błąd importu", "Dane są w niepoprawnym formacie");
            return;
        }

        if (jokeObjects is null)
        {
            await Modal.ShowMessageAsync("Błąd importu", "Dane są puste");
            return;
        }

        if (!DataVersion.IsCompatible(Config.Version, jokeObjects.Version))
        {
            await Modal.ShowMessageAsync("Błąd importu", "Dane są niekompatybilne z aktualną wersją aplikacji");
            return;
        }

        var insertSql = string.Join(',', jokeObjects.JokeObjects.Select(jo => $"('{jo.Author}','{jo.Name}','{jo.Description}',{(int)jo.Type},'{jo.CreationDate:yyyy-MM-dd}')"));
        await DbContext.Database.ExecuteSqlRawAsync($"INSERT INTO JokeObjects (Author, Name, Description, Type, CreationDate) VALUES {insertSql} ON Conflict(Name) DO NOTHING;");
            
        if(new Uri(NavigationManager.Uri).AbsolutePath == "/items")
        {
            NavigationManager.Refresh(true);
        }
    }

    private async Task Export()
    {
        var path = Path.Combine(FileSystem.Current.CacheDirectory, "jokeExport.json");
        var stream = File.OpenWrite(path);
        await JsonSerializer.SerializeAsync(stream, await JokeService.ExportData());
        
        await Share.Default.RequestAsync(new ShareFileRequest { Title = "Eksportuj przedmioty", File = new ShareFile(path) });
    }
}